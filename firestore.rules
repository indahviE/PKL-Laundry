rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi bantu untuk mengecek apakah user sudah login melalui Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fungsi bantu untuk memastikan user hanya bisa akses datanya sendiri (Path Isolation)
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // CS/admin platform NetWash (bukan admin per-perusahaan) -- role ini
    // dibaca dari dokumen profil user sendiri (users/{uid}.role == 'admin').
    // Cuma dipakai buat 2 rule sempit di bawah (profil + support_messages),
    // BUKAN akses penuh ke semua data user lain (orders/customers/dst
    // tetap isolated per pemiliknya).
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Mengamankan seluruh sub-koleksi utama di bawah users/{userId}
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // 1b. Admin/CS boleh baca profil dasar user manapun (buat nampilin
    // nama di daftar percakapan CS), TAPI tetap tidak boleh baca/tulis
    // subcollection user itu (orders, customers, dst) lewat rule ini --
    // itu masih exclusive isOwner lewat rule #1 di atas.
    match /users/{userId} {
      allow read: if isAdmin();
    }

    // 1c. Chat CS ("Chat dan CS" di NotificationsScreen): pemilik akun
    // tetap baca/tulis penuh lewat rule #1. Admin/CS ditambahin akses
    // sempit di sini: boleh baca semua percakapan, dan boleh KIRIM pesan
    // hanya dengan sender == 'cs' (tidak bisa nyamar jadi 'user').
    match /users/{userId}/support_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.sender == 'cs';
    }

    // 2. Aturan spesifik tambahan untuk koleksi 'orders' milik user tertentu (Validasi Data)
    match /users/{userId}/orders/{orderId} {
      // Validasi saat membuat order baru: Pastikan field penting tidak kosong
      allow create: if isAuthenticated() && isOwner(userId) 
        && request.resource.data.customer_id != null
        && request.resource.data.service_type_id != null
        && request.resource.data.total_amount != null;
        
      // Validasi saat update status order: Hanya boleh mengubah status dan riwayatnya saja
      allow update: if isAuthenticated() && isOwner(userId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'status_history', 'updated_at', 'payment_status']));
    }
    
    // Deny all secara global untuk keamanan ekstra di root level
    match /{document=**} {
      allow read, write: if false;
    }
  }
}